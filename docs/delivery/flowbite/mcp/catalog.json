{
  "tools": [
    {
      "name": "convert-figma-to-code",
      "description": "Fetches a Figma node and its rendered image from the Figma API and converts it to a code block. Requires FIGMA_ACCESS_TOKEN environment variable to be set.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "figmaNodeUrl": {
            "type": "string",
            "description": "The URL of the Figma node (e.g., https://www.figma.com/design/fileKey/fileName?node-id=123-456)"
          }
        },
        "required": [
          "figmaNodeUrl"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "generate-theme",
      "description": "Generates a custom Flowbite theme CSS file based on a brand color (hex format) and user instructions. The AI will intelligently analyze the instructions and customize ALL theme variables (border radius, spacing, colors, typography, etc.) to match the desired aesthetic. This tool creates color shades and variations, adapting the entire theme system to match your brand identity.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "brandColor": {
            "type": "string",
            "description": "The primary brand color in hex format (e.g., #3B82F6, #FF5733). This will be used as the base for generating all brand color variations."
          },
          "instructions": {
            "type": "string",
            "description": "Natural language instructions describing the desired theme aesthetic and customizations. The AI will interpret these instructions to modify all relevant theme variables. Examples: \"Make it modern and minimalist with soft rounded corners\", \"Create a luxury feel with gold accents and elegant spacing\", \"Design for a playful children's app with bright colors\", \"Professional corporate style with subtle borders\", etc."
          },
          "fileName": {
            "type": "string",
            "description": "Optional filename for the generated theme (e.g., \"my-brand-theme.css\"). Defaults to \"custom-theme.css\""
          }
        },
        "required": [
          "brandColor",
          "instructions"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ],
